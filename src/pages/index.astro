---
import Base from '../layouts/Base.astro';
import { site, projects, about } from '../data/site';
const year = new Date().getFullYear();
---
<Base>
  <div class="wrap">
    <header class="top">
      <a class="mark" href="#top">Reza<span>.</span>Afsariazar</a>
      <nav aria-label="Sections"><a href="#work">Work</a><a href="#about">About</a><a href="#contact">Contact</a></nav>
    </header>

    <main>
      <div class="hero" id="top">
        <div>
          <p class="coords">{site.coords} · {site.location}</p>
          <h1>Maps, sun and <em>software</em> for real cities.</h1>
          <p class="lede">I build web tools on top of geospatial data: routing, 3D city models and shade, from the database to the pixel.</p>
          <div class="cta">
            <a class="btn primary" href="#work">See projects</a>
            <a class="btn" href="#contact">Get in touch</a>
          </div>
        </div>

        <div class="plate">
          <div class="plate-head"><span>Plate 01 · Shadow study</span><span id="phase">Mid-day</span></div>
          <svg id="map" viewBox="0 0 400 320" role="img" aria-label="Top-down block of buildings and trees with shadows that move with the sun"></svg>
          <div class="slider">
            <label for="hour">Time</label>
            <input id="hour" type="range" min="360" max="1200" step="5" value="840" />
            <output id="clock" for="hour">14:00</output>
          </div>
          <div class="plate-foot"><span id="alt">Sun altitude</span><span id="az">Azimuth</span></div>
        </div>
      </div>

      <section id="work">
        <div class="sec-head"><h2>Selected work</h2><p>Projects that start from real data.</p></div>
        {projects.map((p) => (
          <article class:list={['proj', { ghost: p.placeholder }]}>
            <div class="meta">{p.year}<br />{p.kind}</div>
            <div>
              <h3>{p.title}{p.placeholder && <span class="badge">Placeholder</span>}</h3>
              <p>{p.body}</p>
              <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
              {p.links.length > 0 && (
                <div class="links">
                  {p.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}
                </div>
              )}
            </div>
          </article>
        ))}
      </section>

      <section id="about">
        <div class="sec-head"><h2>About</h2><p>From data to something people can walk through.</p></div>
        <div class="about">
          <div></div>
          <div>
            <p>{about.text}{about.placeholder && <span class="badge">Placeholder</span>}</p>
            <div class="skills">
              {about.skills.map((s) => <div><h4>{s.h}</h4><p>{s.p}</p></div>)}
            </div>
          </div>
        </div>
      </section>

      <section id="contact">
        <div class="sec-head"><h2>Contact</h2><p>Open to interesting problems.</p></div>
        <div class="contact-row">
          <span class="big" id="mail">{site.email.value}</span>
          <button type="button" id="copy">Copy address</button>
          {site.email.placeholder && <span class="badge">Placeholder</span>}
        </div>
        <div class="contact-links">
          <a href={site.linkedin.value} target="_blank" rel="noopener">LinkedIn ↗</a>
          <a href={site.github} target="_blank" rel="noopener">GitHub ↗</a>
          <a href={site.cv.href} download>CV (PDF) ↓</a>
          {(site.linkedin.placeholder || site.cv.placeholder) && <span class="badge">LinkedIn URL + CV are placeholders</span>}
        </div>
      </section>
    </main>

    <footer>
      <span>© {year} {site.name} · {site.location}</span>
      <button class="theme-btn" id="theme" type="button">Toggle theme</button>
    </footer>
  </div>

  <script src="../scripts/plate.ts"></script>
</Base>
