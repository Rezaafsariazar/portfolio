---
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import { ui, type Lang } from '../i18n/ui';

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const other: Lang = lang === 'en' ? 'de' : 'en';
const otherHref = other === 'en' ? '/' : '/de/';

const projects = (await getCollection('projects')).sort((a, b) => {
  const ph = Number(a.data.status === 'placeholder') - Number(b.data.status === 'placeholder');
  return ph || b.data.year.localeCompare(a.data.year) || a.data.title.localeCompare(b.data.title);
});
const pad = (n: number) => String(n).padStart(2, '0');
---
<div class="wrap">
  <a class="skip" href="#work">{t.skip}</a>
  <header class="top">
    <a class="mark" href={lang === 'en' ? '/' : '/de/'}>Reza Afsariazar</a>
    <nav aria-label="Sections">
      <a href="#work">{t.nav.work}</a><a href="#about">{t.nav.about}</a><a href="#contact">{t.nav.contact}</a>
      <a class="lang" href={otherHref} hreflang={other} lang={other} aria-label={t.langSwitchLabel}>{t.langSwitch}</a>
    </nav>
  </header>

  <main>
    <div class="sky" aria-hidden="true">
      <div class="sun"></div>
      <div class="sky-hours mono"><span>06:00</span><span>12:00</span><span>20:00</span></div>
    </div>

    <div class="hero" id="top">
      <p class="mono">{site.coords} · {site.location}</p>
      <h1>{t.h1a}<em>{t.h1b}</em>{t.h1c}</h1>
      <p class="lede">{t.lede}</p>
      <div class="cta">
        <a href="#work">{t.ctaWork} ↓</a>
        <a href="#contact">{t.ctaContact}</a>
      </div>

      <figure class="plate" id="plate" data-alt={t.alt} data-az={t.az} data-low={t.phases.low} data-mid={t.phases.mid} data-high={t.phases.high}>
        <div class="plate-head"><span>{t.plate}</span><span id="phase">{t.phases.mid}</span></div>
        <svg id="map" viewBox="0 0 400 320" role="img" aria-label={t.plateLabel}></svg>
        <div class="slider">
          <label for="hour">{t.time}</label>
          <input id="hour" type="range" min="360" max="1200" step="5" value="840" />
          <output id="clock" for="hour">14:00</output>
        </div>
        <div class="plate-foot"><span id="alt">{t.alt}</span><span id="az">{t.az}</span></div>
        <ul class="legend" aria-hidden="true">
          <li><i class="k-b"></i>{t.legend.building}</li>
          <li><i class="k-t"></i>{t.legend.tree}</li>
          <li><i class="k-s"></i>{t.legend.shadow}</li>
          <li><i class="k-u"></i>{t.legend.sun}</li>
        </ul>
      </figure>
    </div>

    <section id="work">
      <div class="sec-head"><h2>{t.workH}</h2><p>{t.workP}</p></div>
      <ol class="index">
        {projects.map((p, i) => (
          <li class:list={['item', { ghost: p.data.status === 'placeholder', lead: i === 0 }]}>
            <span class="no">{pad(i + 1)}</span>
            <h3>
              {p.data.title}
              {p.data.status === 'placeholder' && <span class="badge">{t.placeholder}</span>}
            </h3>
            <span class="when">{p.data.year ? `${p.data.year} · ` : ''}{p.data.type[lang]}</span>
            <div class="body">
              <p>{p.data.summary[lang]}</p>
              {p.data.stack.length > 0 && <p class="stack">{p.data.stack.join(' · ')}</p>}
              {p.data.links.length > 0 && (
                <div class="links">
                  {p.data.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{t[l.kind]} ↗</a>)}
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section id="about">
      <div class="sec-head"><h2>{t.aboutH}</h2><p>{t.aboutP}</p></div>
      <div class="about-body">
        {t.about.map((para) => <p>{para}</p>)}
        <div class="skills">
          {t.skills.map((s) => <div><b>{s.h}</b>{s.p}</div>)}
        </div>
      </div>
    </section>

    <section id="contact">
      <div class="sec-head"><h2>{t.contactH}</h2><p>{t.contactP}</p></div>
      <span class="contact-big" id="mail">{site.email.value}</span>
      <div class="contact-row">
        <button type="button" id="copy" data-label={t.copy} data-copied={t.copied} data-fail={t.copyFail}>{t.copy}</button>
        <a href={site.linkedin.value} target="_blank" rel="noopener">LinkedIn ↗</a>
        <a href={site.github} target="_blank" rel="noopener">GitHub ↗</a>
      </div>
    </section>
  </main>

  <footer>
    <span>© {new Date().getFullYear()} {site.name} · {site.location}</span>
  </footer>
</div>

<script src="../scripts/plate.ts"></script>
